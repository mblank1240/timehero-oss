DATABASE_URL="postgresql://localhost:5432/timehero_dev"

# Auth.js — generate with: openssl rand -base64 33 (production needs 32+ characters)
AUTH_SECRET=""

# Microsoft Entra ID (see docs/ENTRA-SETUP.md). Leave all three blank to use the
# dev bypass; the issuer looks like https://login.microsoftonline.com/<TENANT_ID>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# Google sign-in. Leave both blank to switch it off. Register the Workspace
# domains under Admin -> Directory so accounts are linked by address.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Passwordless sign-in by emailed link. Needs outgoing mail (below), a sending
# address set by an administrator, and in production APP_URL.
AUTH_EMAIL_LINKS="false"

# Where this deployment is reached, e.g. https://time.example.org. Links in
# mail and the Microsoft consent redirect are built from it. Required in production.
APP_URL=""

# Outgoing mail: smtp | graph | file | console. Unset outside production means
# "file": each message is written to MAIL_FILE_DIR instead of being sent.
# file and console are development only; production refuses to start with them.
# graph sends with the Entra app (Mail.Send). The address mail comes from is
# not set here: an administrator sets it under Administration → Notifications,
# and with none set no email is sent at all.
MAIL_TRANSPORT=""
SMTP_URL=""            # e.g. smtps://user:password@smtp.example.org:465
MAIL_FILE_DIR=".mail-outbox"

# Web Push. Generate a key pair with: npx web-push generate-vapid-keys
# VAPID_SUBJECT is a contact for the push services: mailto:… or https://…
# Unset, push is off and notifications reach the in-app list and email only.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# Dev-only sign-in bypass. MUST be unset in production — the app refuses to boot otherwise.
DEV_AUTH_BYPASS="false"

# Shared secret for the scheduled job routes (/api/jobs/*). Generate with:
# openssl rand -hex 32. Required in production, at least 32 characters;
# without it the job routes refuse every request.
JOBS_SECRET=""
