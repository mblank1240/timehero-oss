# Environment for docker-compose.yml. Copy to .env.docker and fill in.
# Every variable is described in .env.example; this file holds the ones a
# self-hosted install needs.

# The database. Generate a password — openssl rand -hex 24 — and use the same
# one in both lines. Do not keep change-me: it is the first thing anyone tries.
POSTGRES_PASSWORD="change-me"
DATABASE_URL="postgresql://timehero:change-me@db:5432/timehero"

# Where staff reach TimeHero, through your HTTPS reverse proxy. Both lines.
APP_URL="https://time.example.org"
AUTH_URL="https://time.example.org"

# openssl rand -base64 33. At least 32 characters, or the app will not start.
AUTH_SECRET=""
# openssl rand -hex 32. At least 32 characters. The scheduler and the app share it.
JOBS_SECRET=""

# Sign-in: at least one. Emailed links need outgoing mail below, and a sending
# address (npm run setup -- --mail-from, or Administration → Notifications).
AUTH_EMAIL_LINKS="true"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# Outgoing mail: smtp, or graph with the Microsoft app above.
MAIL_TRANSPORT="smtp"
SMTP_URL="smtps://user:password@smtp.example.org:465"

# Web Push (optional): npx web-push generate-vapid-keys. Keep the pair once
# generated — a new pair silently unsubscribes every browser.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
